# Copy to .env.development or .env.production and fill real values
# DO NOT commit .env.production with real secrets

APP_ENV=development
APP_ADDR=:5504
APP_SHUTDOWN_TIMEOUT=30s

DATABASE_DSN=postgres://postgres:CHANGE_ME@localhost:5432/bizsawa?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bizsawa
# Host port for the containerized Postgres. Set to 5433 (or similar) when a
# system Postgres already binds 5432 locally.
POSTGRES_PORT=5432

# PowerSync (self-hosted service + local replication bootstrap).
# Pin a specific version in production (currently 1.28.3); latest is fine for dev.
POWERSYNC_IMAGE_TAG=latest
POWERSYNC_PORT=8090
# service.dev.yaml (static HS256 dev key) in development;
# service.prod.yaml (Clerk JWKS) in production.
POWERSYNC_CONFIG_FILE=service.dev.yaml
POWERSYNC_DB_USER=powersync_role
POWERSYNC_DB_PASSWORD=CHANGE_ME
# Base64url-encoded HS256 key — development tokens only.
POWERSYNC_CLIENT_AUTH_KEY=cG93ZXJzeW5jLWRldi1vbmx5LWtleS0zMi1ieXRlcyEh
# Admin API token (strong random value in production).
POWERSYNC_API_TOKEN=CHANGE_ME
# Production client auth: Clerk JWKS (normally the same value as CLERK_JWKS_URL).
POWERSYNC_JWKS_URI=
# Override only when the replication source / bucket storage is external
# (e.g. Supabase). Defaults point at the compose Postgres.
# POWERSYNC_DATA_HOST=
# POWERSYNC_DATA_PORT=5432
# POWERSYNC_DATA_DB=bizsawa
# POWERSYNC_DATA_SSLMODE=require
# POWERSYNC_STORAGE_HOST=
# POWERSYNC_STORAGE_PORT=5432
# POWERSYNC_STORAGE_DB=powersync_storage
# POWERSYNC_STORAGE_USER=
# POWERSYNC_STORAGE_SSLMODE=require

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# `http://localhost:*` / `http://127.0.0.1:*` cover every local dev port —
# Expo falls back to 8082+ when 8081 is busy, and a port-pinned origin would
# then be blocked by CORS and surface as "Network Error" in the browser.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.bizsawa.com,http://192.168.*,http://10.*,http://172.*,exp://*
JWT_ISSUER=bizsawa
JWT_SIGNING_KEY=CHANGE_ME_generate_uuid

WHATSAPP_DRIVER=waha
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION_ID=test_session
WAHA_API_KEY=CHANGE_ME

CRYPTO_MASTER_KEY=CHANGE_ME_32_bytes_hex
CRYPTO_INDEX_SECRET=CHANGE_ME_32_bytes_hex

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_BUSINESS_SHORTCODE=174379
MPESA_INITIATOR_NAME=CHANGE_ME
MPESA_SECURITY_CREDENTIAL=CHANGE_ME

OPENROUTER_API_KEY=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME

# Clerk SSO — JWKS URL is used to verify incoming Clerk JWTs.
# Publishable key is safe to expose to clients; secret key must stay server-side.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Chat LLM failover (comma-separated) for 429/5xx on the primary LLM_MODEL
LLM_FALLBACK_MODELS=

OTEL_ENABLED=true
OTEL_SERVICE_NAME=bizsawa-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# PesaCast webhook receiver
PESACAST_SIGNING_SECRET=
PESACAST_BEARER_TOKEN=
PESACAST_MAX_CLOCK_SKEW=5m
PESACAST_MAX_BODY_BYTES=1048576
PESACAST_ALLOW_INSECURE=false
