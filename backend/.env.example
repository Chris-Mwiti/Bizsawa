# Copy to .env.development or .env.production and fill real values
# DO NOT commit .env.production with real secrets

APP_ENV=development
APP_ADDR=:5504
APP_SHUTDOWN_TIMEOUT=30s

DATABASE_DSN=postgres://postgres:CHANGE_ME@localhost:5432/bizsawa?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bizsawa

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ISSUER=bizsawa
JWT_SIGNING_KEY=CHANGE_ME_generate_uuid

WHATSAPP_DRIVER=waha
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION_ID=test_session
WAHA_API_KEY=CHANGE_ME

CRYPTO_MASTER_KEY=CHANGE_ME_32_bytes_hex
CRYPTO_INDEX_SECRET=CHANGE_ME_32_bytes_hex

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_BUSINESS_SHORTCODE=174379
MPESA_INITIATOR_NAME=CHANGE_ME
MPESA_SECURITY_CREDENTIAL=CHANGE_ME

OPENROUTER_API_KEY=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME

OTEL_ENABLED=true
OTEL_SERVICE_NAME=bizsawa-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
