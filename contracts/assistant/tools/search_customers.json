{
  "name": "search_customers",
  "input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Customer name, phone, or email fragment."
      },
      "limit": {
        "type": "integer",
        "description": "Maximum candidates to return; default 10, max 50.",
        "minimum": 1,
        "maximum": 50
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "customer_id": { "type": "string" },
            "name": { "type": "string" },
            "phone_last4": { "type": "string" },
            "email_domain": { "type": "string" },
            "loyalty_points": { "type": "integer" }
          },
          "required": [
            "customer_id",
            "name",
            "phone_last4",
            "email_domain",
            "loyalty_points"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["results"],
    "additionalProperties": false
  }
}
