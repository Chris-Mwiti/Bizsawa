# Gemini API Key
EXPO_PUBLIC_GEMINI_KEY=your_gemini_api_key

# Backend API URL (host only; /api is appended in mobile/lib/api.ts)
# Local dev: your machine LAN IP and API port
EXPO_PUBLIC_API_URL=http://your-local-ip:3000
# Production (Render) — set in EAS secrets or local .env only; do not commit the live URL:
# EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com
