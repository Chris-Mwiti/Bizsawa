# BizSawa mobile env — copy to .env.development / .env.staging / .env.production (gitignored)
# See deployment_sage.md Phase A1 for injection via eas secret:create

# Backend API root (host + /api/v1). mobile/lib/api.ts appends /api/v1 if missing.
# Used by the native (Android/iOS) app. Set it to the host's LAN IP so a
# physical device can reach the backend — `bun run android:lan` resolves and
# refreshes it automatically. The IP is DHCP-bound and goes stale, which is
# what caused the recurring "Network Error" on device.
EXPO_PUBLIC_API_URL=

# Optional: API root for the web build only (`bun run web`).
# Leave unset for local dev: the web build derives the API host from the
# browser's own location (window.location.hostname), so it works on both
# localhost and the LAN address and can never go stale.
# Set it to point the web build at a deployed environment:
# EXPO_PUBLIC_WEB_API_URL=https://api.bizsawa.chrismwiti.me/api/v1

# Expo project (from app.json extra.eas.projectId)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: override for local dev without tunnel (Expo will fallback to hostUri:5504)
# Tip: `bun run android:lan` auto-resolves + refreshes this; get the IP manually via ./scripts/resolve-lan-ip.sh
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5504/api/v1

# Gemini (optional AI features)
# EXPO_PUBLIC_GEMINI_KEY=your_gemini_api_key
