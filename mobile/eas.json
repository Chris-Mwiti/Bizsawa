{
  "cli": {
    "version": ">= 5.9.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.bizsawa.chrismwiti.me/api/v1"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.bizsawa.chrismwiti.me/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.bizsawa.chrismwiti.me/api/v1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "production-simulator": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
