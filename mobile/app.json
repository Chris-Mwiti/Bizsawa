{
  "expo": {
    "name": "BizSawa",
    "slug": "bizsawa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "light",
    "scheme": "bizsawa",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F9F7"
    },
    "ios": {
      "bundleIdentifier": "com.bizsawa.mobile",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.bizsawa.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F9F7"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin/app.plugin.js",
      "@react-native-firebase/app/app.plugin.js",
      [
        "expo-system-ui",
        {
          "backgroundColor": "#F4F9F7"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so", "**/libfbjni.so"]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": false
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "875b82a6-0306-4849-949b-b55ac683eb92"
      }
    }
  }
}
